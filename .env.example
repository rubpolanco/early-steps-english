# Copy this to .env.local for local overrides (optional — the app works
# with zero env vars set locally). In production (Railway, Render, etc.)
# set these in your host's dashboard instead of committing a .env file.

# Long random string used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Where the SQLite database + uploaded photos/videos are stored.
# Locally this defaults to ./data with no configuration needed.
# In production, point this at a mounted persistent volume, e.g. /data
STORAGE_DIR=
